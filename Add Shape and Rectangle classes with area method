#include <iostream>
using namespace std;

class Shape
{
public:
    virtual void area()
    {
        cout << "Area of Shape";
    }
};

class Rectangle : public Shape
{
    float length, breadth;

public:
    Rectangle(float l, float b)
    {
        length = l;
        breadth = b;
    }

    void area() override
    {
        cout << "Area of Rectangle = " << length * breadth;
    }
};

int main()
{
    Rectangle r(5, 10);

    Shape *ptr;
    ptr = &r;

    ptr->area();

    return 0;
}
