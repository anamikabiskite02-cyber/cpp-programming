#include <iostream>
using namespace std;

class Shape
{
public:
    virtual void area()
    {
        cout << "Area of Shape";
    }
};

class Circle : public Shape
{
    float radius;

public:
    Circle(float r)
    {
        radius = r;
    }

    void area() override
    {
        cout << "Area of Circle = " << 3.14 * radius * radius;
    }
};

int main()
{
    Circle c(2);

    Shape *ptr;
    ptr = &c;

    ptr->area();

    return 0;
}
